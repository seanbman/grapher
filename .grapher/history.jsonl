erve keyed-node and migration compatibility. Do not build ML or training functionality, model-specific fields, prompts, quality labels, or transcript hoards.", "created_at": "2026-09-03T12:58:42+00:00", "evidence": [], "id": "spec-grapher-provenance-readiness", "meta": {}, "owners": [], "path": "docs/Grapher Provenance and Future Training Readiness.pdf", "provenance": {"actor_id": "codex-provenance-implementer", "actor_kind": "agent", "integrity": "declared", "recorded_at": "2026-09-03T12:58:42+00:00", "source": "codex"}, "scope": {}, "source_refs": [], "stage": null, "status": "canonical_spec", "tags": ["specification", "provenance", "history", "auditability", "training-readiness"], "title": "Grapher provenance and future training readiness addendum", "type": "document", "updated_at": "2026-09-03T12:58:42+00:00", "verification": "verified", "workflow_state": "not_applicable"}, "timestamp": "2026-09-03T12:58:42+00:00"}]}
