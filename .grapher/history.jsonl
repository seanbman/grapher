pe": {}, "source_refs": [], "stage": null, "status": "canonical_spec", "tags": ["actors", "evidence", "overrides", "provenance"], "title": "Attribute actors evidence and overrides", "type": "requirement", "updated_at": "2026-09-03T12:58:59+00:00", "verification": "verified", "workflow_state": "not_applicable"}, "timestamp": "2026-09-03T12:58:59+00:00"}]}
