actor_kind": "agent", "integrity": "declared", "recorded_at": "2026-09-03T12:58:57+00:00", "source": "codex"}, "scope": {}, "source_refs": [], "stage": null, "status": "canonical_spec", "tags": ["provenance", "transitions", "auditability"], "title": "Preserve structured graph state transitions", "type": "requirement", "updated_at": "2026-09-03T12:58:57+00:00", "verification": "verified", "workflow_state": "not_applicable"}, "timestamp": "2026-09-03T12:58:57+00:00"}]}
