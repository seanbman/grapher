{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanbman/grapher/research/training-data/schema.v1.json",
  "title": "Grapher Derived Example v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "example_kind",
    "purpose",
    "source",
    "input",
    "target",
    "quality",
    "split_group",
    "export"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "example_id": { "type": "string", "minLength": 1 },
    "example_kind": {
      "enum": [
        "state_to_decision",
        "state_to_action",
        "decision_to_outcome",
        "failure_to_lesson",
        "verification_judgment",
        "sequence_completion"
      ]
    },
    "purpose": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["training", "evaluation"] }
    },
    "source": { "$ref": "#/$defs/source" },
    "input": { "$ref": "#/$defs/side" },
    "target": { "$ref": "#/$defs/side" },
    "quality": { "$ref": "#/$defs/quality" },
    "split_group": { "type": "string", "minLength": 1 },
    "export": { "$ref": "#/$defs/export" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_hash", "graph_version", "snapshot_ref"],
      "properties": {
        "graph_hash": { "type": "string", "minLength": 16 },
        "graph_version": { "type": "integer", "minimum": 1 },
        "snapshot_ref": { "type": "string", "minLength": 1 },
        "project_id": { "type": ["string", "null"] },
        "mission_id": { "type": ["string", "null"] },
        "generation_id": { "type": ["string", "null"] },
        "episode_id": { "type": ["string", "null"] }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "relations"],
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/record" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "status",
        "verification",
        "workflow_state",
        "content",
        "source_refs",
        "evidence_refs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "workflow_state": { "type": "string", "minLength": 1 },
        "stage": { "type": ["string", "null"] },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "semantic" },
                "value": { "type": "object", "minProperties": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "text" },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actor_id": { "type": ["string", "null"] },
            "actor_kind": { "type": ["string", "null"] },
            "actor_role": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"] },
            "integrity": { "type": ["string", "null"] }
          }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "rel"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "rel": { "type": "string", "minLength": 1 },
        "note": { "type": ["string", "null"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "policy_version",
        "evidence_strength",
        "unresolved_contradiction",
        "target_superseded",
        "warnings"
      ],
      "properties": {
        "eligible": { "type": "boolean" },
        "policy_version": { "type": "string", "minLength": 1 },
        "evidence_strength": {
          "enum": ["none", "declared", "partial", "verified"]
        },
        "unresolved_contradiction": { "type": "boolean" },
        "target_superseded": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exporter", "exporter_version", "created_at"],
      "properties": {
        "exporter": { "type": "string", "minLength": 1 },
        "exporter_version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
